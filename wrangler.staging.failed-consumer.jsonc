{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "leadmaster-staging-mail-failed-consumer",
  "main": "workers/mail-failed-consumer.js",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "leadmaster-staging-release-20261110",
      "database_id": "78cfdd79-cd90-4c06-9d1e-2f391a3496d1"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "leadmaster-staging-mail-failed",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 1,
        "max_concurrency": 1
      }
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "persist": true
    }
  }
}
