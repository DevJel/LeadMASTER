{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "leadmaster",
  "main": "worker.js",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "APP_HOSTNAME": "leadmaster.jelvan.pro",
    "SES_FROM_EMAIL": "noreply@leadmaster.jelvan.pro",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF6m40DGlxOgE2qB",
    "SES_CONFIGURATION_SET": "leadmaster-events",
    "SES_SNS_TOPIC_ARN": "arn:aws:sns:ap-southeast-2:592505728137:leadmaster-ses-events",
    "SES_MAX_MESSAGES_PER_SECOND": "10",
    "SES_MAX_MESSAGES_PER_DAY": "50000"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "leadmaster-auth",
      "database_id": "246db481-9bff-4088-8dcc-b810138aea68",
      "migrations_dir": "migrations"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "SES_SMTP_HOST",
      "store_id": "e4c5eeca43e24f1fa21e6f808180e0dc",
      "secret_name": "AWS_SES_SMTP_HOSTNAME"
    },
    {
      "binding": "SES_SMTP_USERNAME",
      "store_id": "e4c5eeca43e24f1fa21e6f808180e0dc",
      "secret_name": "AWS_SES_SMTP_USERNAME"
    },
    {
      "binding": "SES_SMTP_PASSWORD",
      "store_id": "e4c5eeca43e24f1fa21e6f808180e0dc",
      "secret_name": "AWS_SES_SMTP_PASSWORD"
    },
    {
      "binding": "ADMIN_EMAIL",
      "store_id": "e4c5eeca43e24f1fa21e6f808180e0dc",
      "secret_name": "ADMIN_EMAIL_1"
    },
    {
      "binding": "ADMIN_PASSWORD",
      "store_id": "e4c5eeca43e24f1fa21e6f808180e0dc",
      "secret_name": "ADMIN_PASSWORD_1"
    },
    {
      "binding": "SESSION_SECRET",
      "store_id": "e4c5eeca43e24f1fa21e6f808180e0dc",
      "secret_name": "ADMIN_JWT_1"
    },
    {
      "binding": "TURNSTILE_SECRET",
      "store_id": "e4c5eeca43e24f1fa21e6f808180e0dc",
      "secret_name": "TURNSTILE_SECRET_KEY"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "persist": true
    }
  },
  "r2_buckets": [
    {
      "binding": "INBOUND_MAIL",
      "bucket_name": "leadmaster-inbound-mail"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "MAIL_SEND_QUEUE",
        "queue": "leadmaster-mail-send"
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "EMAIL_COORDINATOR",
        "class_name": "EmailCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EmailCoordinator"]
    }
  ]
}