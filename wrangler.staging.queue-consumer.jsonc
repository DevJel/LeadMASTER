{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "leadmaster-staging-mail-queue-consumer",
  "main": "workers/mail-queue-consumer.js",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "SES_FROM_EMAIL": "staging-admin@leadmaster.test",
    "SES_CONFIGURATION_SET": "leadmaster-staging-events"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "leadmaster-staging-release-20261110",
      "database_id": "78cfdd79-cd90-4c06-9d1e-2f391a3496d1"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "leadmaster-staging-mail-send",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "retry_delay": 15,
        "max_concurrency": 1,
        "dead_letter_queue": "leadmaster-staging-mail-failed"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "persist": true
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "EMAIL_COORDINATOR",
        "class_name": "EmailCoordinator",
        "script_name": "leadmaster-staging-release"
      }
    ]
  }
}
