{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "leadmaster",
  "main": "worker.js",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [],
  "triggers": {
    "crons": [
      "0 9 * * *"
    ]
  },
  "vars": {
    "SES_FROM_EMAIL": "noreply@leadmaster.jelvan.pro",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF6m40DGlxOgE2qB",
    "SES_CONFIGURATION_SET": "leadmaster-events",
    "SES_SNS_TOPIC_ARN": "arn:aws:sns:ap-southeast-2:592505728137:leadmaster-ses-events",
    "SES_MAX_MESSAGES_PER_SECOND": "10",
    "SES_MAX_MESSAGES_PER_DAY": "50000",
    "APP_HOSTNAME": "leadmaster.jelvan.pro",
    "REPORTER_APP_URL": "https://leadmaster.jelvan.space",
    "REPORTER_GITHUB_REPOSITORY": "DevJel/LeadMASTER",
    "REPORTER_CF_ACCOUNT_ID": "967aa086112f862ba9f50ccf7aa09246",
    "REPORTER_TIME_ZONE": "Asia/Kuala_Lumpur",
    "TURSO_URL": "libsql://leadmaster-devjel.aws-ap-southeast-2.turso.io"
  },
  "secrets_store_secrets": [
    {
      "binding": "SES_SMTP_HOST",
      "store_id": "e4c5eeca43e24f1fa21e6f808180e0dc",
      "secret_name": "AWS_SES_SMTP_HOSTNAME"
    },
    {
      "binding": "SES_SMTP_USERNAME",
      "store_id": "e4c5eeca43e24f1fa21e6f808180e0dc",
      "secret_name": "AWS_SES_SMTP_USERNAME"
    },
    {
      "binding": "SES_SMTP_PASSWORD",
      "store_id": "e4c5eeca43e24f1fa21e6f808180e0dc",
      "secret_name": "AWS_SES_SMTP_PASSWORD"
    },
    {
      "binding": "ADMIN_EMAIL",
      "store_id": "e4c5eeca43e24f1fa21e6f808180e0dc",
      "secret_name": "ADMIN_EMAIL_1"
    },
    {
      "binding": "ADMIN_PASSWORD",
      "store_id": "e4c5eeca43e24f1fa21e6f808180e0dc",
      "secret_name": "ADMIN_PASSWORD_1"
    },
    {
      "binding": "SESSION_SECRET",
      "store_id": "e4c5eeca43e24f1fa21e6f808180e0dc",
      "secret_name": "ADMIN_JWT_1"
    },
    {
      "binding": "TURNSTILE_SECRET",
      "store_id": "e4c5eeca43e24f1fa21e6f808180e0dc",
      "secret_name": "TURNSTILE_SECRET_KEY"
    },
    {
      "binding": "TURSO_AUTH_TOKEN",
      "store_id": "e4c5eeca43e24f1fa21e6f808180e0dc",
      "secret_name": "TURSO_AUTH_TOKEN"
    ,
    {
      "binding": "GITHUB_TOKEN",
      "store_id": "e4c5eeca43e24f1fa21e6f808180e0dc",
      "secret_name": "GITHUB_TOKEN"
    },
    {
      "binding": "CF_API_TOKEN",
      "store_id": "e4c5eeca43e24f1fa21e6f808180e0dc",
      "secret_name": "CF_API_TOKEN"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "persist": true
    }
  },
  "kv_namespaces": [
    {
      "binding": "AUTO_HEAL_KV",
      "id": "504506b1b6b3406d89325f17a8a3cf17"
    }
  ],
  "r2_buckets": [
    {
      "binding": "INBOUND_MAIL",
      "bucket_name": "leadmaster-inbound-mail"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "MAIL_SEND_QUEUE",
        "queue": "leadmaster-mail-send"
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "EMAIL_COORDINATOR",
        "class_name": "EmailCoordinator"
      }
    ]
  },
  "exports": {
    "EmailCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
