{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "leadmaster-mail-failed-consumer",
  "main": "workers/mail-failed-consumer.js",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [],
  "workers_dev": false,
  "preview_urls": false,
  "queues": {
    "consumers": [
      {
        "queue": "leadmaster-mail-send-failed",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 1,
        "retry_delay": 15,
        "max_concurrency": 1
      }
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "persist": true
    }
  },
  "vars": {
    "TURSO_URL": "libsql://leadmaster-devjel.aws-ap-southeast-2.turso.io"
  },
  "secrets_store_secrets": [
    {
      "binding": "TURSO_AUTH_TOKEN",
      "store_id": "e4c5eeca43e24f1fa21e6f808180e0dc",
      "secret_name": "TURSO_AUTH_TOKEN"
    }
  ]
}
