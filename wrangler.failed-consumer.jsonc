{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "leadmaster-mail-failed-consumer",
  "main": "workers/mail-failed-consumer.js",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "leadmaster-auth",
      "database_id": "e2ea3d34-1fca-46a9-b70e-1ca07d78f48e"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "leadmaster-mail-send-failed",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 1,
        "max_concurrency": 1
      }
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "persist": true
    }
  }
}
