{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "leadmaster-mail-queue-consumer",
  "main": "workers/mail-queue-consumer.js",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "SES_FROM_EMAIL": "noreply@leadmaster.jelvan.pro",
    "SES_CONFIGURATION_SET": "leadmaster-events"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "leadmaster-auth",
      "database_id": "246db481-9bff-4088-8dcc-b810138aea68"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "SESSION_SECRET",
      "store_id": "e4c5eeca43e24f1fa21e6f808180e0dc",
      "secret_name": "ADMIN_JWT_1"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "leadmaster-mail-send",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "retry_delay": 15,
        "max_concurrency": 1,
        "dead_letter_queue": "leadmaster-mail-send-failed"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "persist": true
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "EMAIL_COORDINATOR",
        "class_name": "EmailCoordinator",
        "script_name": "leadmaster"
      }
    ]
  }
}